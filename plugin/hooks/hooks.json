{
  "description": "PromptGauge collector. Does not store prompt text or block Claude Code.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/runtime/promptgauge.cjs\" collect --pg-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/runtime/promptgauge.cjs\" collect --pg-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/runtime/promptgauge.cjs\" collect --pg-hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
